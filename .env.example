# FirstLight — environment template (NO REAL SECRETS; copy to .env)
# ------------------------------------------------------------------

# RUN MODE -------------------------------------------------------------------
# demo (default)        : client-side simulated platform; static export works.
# operational (false)   : server API + database + auth required. The
#                         DemoScenarioProvider refuses to run silently.
DEMO_MODE=true
# Client-side mirror of DEMO_MODE (Next.js inlines NEXT_PUBLIC_* at build):
NEXT_PUBLIC_DEMO_MODE=true

# DATABASE (operational mode) ------------------------------------------------
# SQLite pilot store. MUST be an ABSOLUTE path — Prisma resolves relative
# `file:` paths against node_modules/.prisma/client and silently creates an
# empty database elsewhere (a failure we hit and fixed; see
# IMPLEMENTATION_BASELINE.md and src/lib/server/db.ts).
DATABASE_URL="file:/ABSOLUTE/PATH/TO/firstlight/db/firstlight.db"
# Production path: PostgreSQL + PostGIS
# DATABASE_URL="postgresql://user:pass@host:5432/firstlight"

# Optional: log every Prisma query (debugging only — noisy)
# PRISMA_LOG=query

# PROVIDER KEYS (server-side ONLY — never NEXT_PUBLIC_*) ---------------------
# NASA FIRMS MAP_TOKEN (free): https://firms.modaps.eosdis.nasa.gov/api/area/
# Until set, the firms-fire adapter reports BLOCKED (never simulated).
# FIRSTLIGHT_FIRMS_TOKEN=

# Copernicus Data Space credentials (full-asset download beyond anonymous
# STAC metadata search): https://dataspace.copernicus.eu/
# FIRSTLIGHT_COPERNICUS_USERNAME=
# FIRSTLIGHT_COPERNICUS_PASSWORD=

# DEPLOYMENT (static demo builds) --------------------------------------------
# GitHub Pages project sites need the base path:
# NEXT_PUBLIC_BASE_PATH=/firstlight
