# FirstLight Python Worker - Raster Processing & ML
# Multi-stage build for optimized production image

# ============================================================================
# Stage 1: Builder
# ============================================================================
FROM python:3.11-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies
COPY python/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Copy Python source files
COPY python/ /app/python/

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM python:3.11-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev \
    gdal-bin \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy from builder
COPY --from=builder /root/.local /root/.local
COPY --from=builder /app/python /app/python

# Ensure scripts in .local are usable
ENV PATH=/root/.local/bin:$PATH

# Install GDAL Python bindings
RUN pip install --no-cache-dir \
    GDAL==$(gdal-config --version) \
    rasterio \
    numpy \
    scipy \
    scikit-image \
    torch \
    torchvision \
    opencv-python \
    pandas \
    shapely \
    geopandas \
    pyproj \
    celery \
    redis \
    psycopg2-binary \
    boto3

# Create non-root user
RUN useradd -m -u 1001 python-worker

# Copy entrypoint script
COPY python/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Switch to non-root user
USER python-worker

# Expose port (for health checks)
EXPOSE 5555

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5555/health')" || exit 1

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV REDIS_URL=redis://redis:6379/0
ENV DATABASE_URL=postgresql://firstlight:firstlight_pass@postgres:5432/firstlight

# Run the worker
CMD ["/app/entrypoint.sh"]
