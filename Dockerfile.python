# FirstLight Python Worker — the REAL worker: celery + hardened egress.
#
# Single small stage. The round-3 image was a two-stage build that pip
# installed the full raster/ML stack (GDAL from source against a builder
# with no libgdal, torch, opencv, segmentation-models-pytorch, …) that no
# task actually imports — tasks return `blocked_scaffold` naming their
# exact missing dependency. That image could never build, and it advertised
# a capability the code does not have. This one ships exactly what runs
# today; see python/requirements.txt for the dependency truth.
FROM python:3.11.9-slim

WORKDIR /app

# TRUE runtime dependencies (secure_download.py is stdlib-only and
# unit-tested: 24/24).
COPY python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Worker source: tasks.py (blocked_scaffold honesty), secure_download.py
# (egress policy), entrypoint.sh (real celery boot).
COPY python/ /app/python/

# Non-root user. The celery CLI is installed system-wide (/usr/local/bin),
# so unlike the old image (pip --user into /root/.local then switching to
# USER python-worker) the worker user can actually execute it.
RUN useradd -m -u 1001 python-worker
COPY python/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
USER python-worker

# Health check — ping THIS worker node through the broker (the previous
# :5555 HTTP health server never existed; this probe is real).
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD celery -A tasks inspect ping -d "celery@$HOSTNAME" || exit 1

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/python
ENV REDIS_URL=redis://redis:6379/0

CMD ["/app/entrypoint.sh"]
